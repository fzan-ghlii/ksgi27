rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client SDK access is locked down by default.
    // All mutations and public reads are mediated by Next.js Server (Firebase Admin SDK).
    // Authenticated users can only read their own user profile.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // strictly through Server Actions / Route Handlers
    }

    // Default deny for all other collections from direct client SDK
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

